    REDIS_URL: redis://user:pass@dev-backend-redis:6379/1

    SOCIAL_AUTH_ALLOWED_REDIRECT_HOSTS: accounts.127.0.0.1.nip.io
    SOCIAL_AUTH_PRO_CONNECT_KEY: ~
    SOCIAL_AUTH_PRO_CONNECT_OIDC_ENDPOINT: https://fca.integ01.dev-agentconnect.fr/api/v2
    SOCIAL_AUTH_PRO_CONNECT_SECRET: ~

    STORAGES_STATICFILES_BACKEND: django.contrib.staticfiles.storage.StaticFilesStorage

  django:
    envVars:
      DB_PSYCOPG_POOL_MIN_SIZE: 10
      WEB_CONCURRENCY: 1

  migrate:
    command:
      - "/bin/sh"
      - "-c"
      - |
        while ! python manage.py check --database default > /dev/null 2>&1
        do
          echo "Database not ready"
          sleep 2
        done

        echo "Database is ready"

        python manage.py migrate --no-input
    restartPolicy: Never

  createsuperuser:
    command:
      - "/bin/sh"
      - "-c"
      - |
        while ! python manage.py check --database default > /dev/null 2>&1
        do
          echo "Database not ready"
          sleep 2
        done

        echo "Database is ready"
        python manage.py createsuperuser --email $DJANGO_SUPERUSER_EMAIL --password $DJANGO_SUPERUSER_PASSWORD
    restartPolicy: Never

  themeCustomization:
    enabled: true
    file_content: {{ readFile "./configuration/theme/demo.json" }}

  # FIXME: Extra volume mounts to manage our local custom CA and avoid to set ssl_verify: false
#  extraVolumeMounts:
#    - name: certs
#      mountPath: /cert/cacert.pem
#      subPath: cacert.pem

  # FIXME: Extra volumes to manage our local custom CA and avoid to set ssl_verify: false
#  extraVolumes:
#    - name: certs
#      configMap:
#        name: certifi
#        items:
#        - key: cacert.pem
#          path: cacert.pem

frontend:
  envVars:
    NEXT_PUBLIC_API_ORIGIN: https://accounts.127.0.0.1.nip.io

  replicas: 1
  command:
    - yarn
    - dev

  image:
    repository: localhost:5001/accounts-frontend
    pullPolicy: Always
    tag: "latest"

  service:
    targetPort: 9900

  securityContext:
    runAsNonRoot: false

ingress:
  enabled: true
  host: accounts.127.0.0.1.nip.io
  annotations:
    nginx.ingress.kubernetes.io/proxy-body-size: 20m

ingressAdmin:
  enabled: true
  host: accounts.127.0.0.1.nip.io

posthog:
  ingress:
    enabled: false

  ingressAssets:
    enabled: false

ingressMedia:
  enabled: true
  host: accounts.127.0.0.1.nip.io

  annotations:
    nginx.ingress.kubernetes.io/auth-url: https://accounts.127.0.0.1.nip.io/api/v1.0/documents/media-auth/
    nginx.ingress.kubernetes.io/auth-response-headers: "Authorization, X-Amz-Date, X-Amz-Content-SHA256"
    nginx.ingress.kubernetes.io/upstream-vhost: dev-backend-minio.accounts.svc.cluster.local:9000
    nginx.ingress.kubernetes.io/rewrite-target: /accounts-media-storage/$1

serviceMedia:
  host: dev-backend-minio.accounts.svc.cluster.local
  port: 9000
