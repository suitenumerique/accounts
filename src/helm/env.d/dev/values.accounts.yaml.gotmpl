djangoSaltKey: &djangoSaltKey "lkjsdlushdgfkfjslkdfjslkdjfslkdjf"
djangoSecretKey: &djangoSecretKey "lkjsdlushdgfkfjslkdfjslkdjfslkdjf"
djangoSuperUserEmail: &djangoSuperUserEmail admin@example.com
djangoSuperUserPass: &djangoSuperUserPass admin
oidc:
    clientId: accounts
    clientSecret: ThisIsAnExampleKeyForDevPurposeOnly

image:
  repository: localhost:5001/accounts-backend
  pullPolicy: Always
  tag: "latest"

backend:
  replicas: 1
  envVars:
    # /!\ Keys are sorted /!\
    AWS_S3_ACCESS_KEY_ID: dinum
    AWS_S3_ENDPOINT_URL: http://dev-backend-minio.accounts.svc.cluster.local:9000
    AWS_S3_SECRET_ACCESS_KEY: password
    AWS_STORAGE_BUCKET_NAME: accounts-media-storage

    CACHES_DEFAULT_KEY_PREFIX: "{{ now | unixEpoch }}"

    DB_HOST: dev-backend-postgres
    DB_NAME:
      secretKeyRef:
        name: dev-backend-postgres
        key: database
    DB_PASSWORD:
      secretKeyRef:
        name: dev-backend-postgres
        key: password
    DB_PORT: 5432
    DB_USER:
      secretKeyRef:
        name: dev-backend-postgres
        key: username

    DJANGO_ALLOWED_HOSTS: accounts.127.0.0.1.nip.io

    DJANGO_CELERY_BROKER_URL: redis://user:pass@dev-backend-redis:6379/1

    DJANGO_CONFIGURATION: Production

    DJANGO_CSRF_TRUSTED_ORIGINS: https://accounts.127.0.0.1.nip.io

    DJANGO_EMAIL_BRAND_NAME: "La Suite Numérique"
    DJANGO_EMAIL_FROM: "suitenumerique-accounts@example.com"
    DJANGO_EMAIL_HOST: "mailcatcher"
    DJANGO_EMAIL_PORT: 1025
    DJANGO_EMAIL_USE_SSL: False
    DJANGO_EMAIL_USE_TLS: False

    DJANGO_SALT_KEY: *djangoSaltKey
    DJANGO_SECRET_KEY: *djangoSecretKey

    DJANGO_SETTINGS_MODULE: accounts.settings

    DJANGO_SUPERUSER_EMAIL: *djangoSuperUserEmail
    DJANGO_SUPERUSER_PASSWORD: *djangoSuperUserPass

    FRONTEND_THEME: dsfr

    LOGGING_LEVEL_LOGGERS_APP: INFO
    LOGGING_LEVEL_LOGGERS_ROOT: INFO

    LOGIN_REDIRECT_URL: https://accounts.127.0.0.1.nip.io
    LOGOUT_REDIRECT_URL: https://accounts.127.0.0.1.nip.io

    MEDIA_BASE_URL: https://accounts.127.0.0.1.nip.io

    OAUTH2_PROVIDER_OIDC_RSA_PRIVATE_KEY: |-
      -----BEGIN RSA PRIVATE KEY-----
      MIIEpQIBAAKCAQEApTqb+jCqIbqGFPkckVSyU71GtCsBXExL54mFO0h8omX1XXHC
